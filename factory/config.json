{
  "concurrency": 3,
  "max_rounds": 3,
  "base_branch": "main",
  "merge_method": "squash",
  "labels": {
    "queue": "factory",
    "needs_info": "factory:needs-info",
    "needs_human": "factory:needs-human",
    "escaped": "factory:escaped",
    "plan": "factory:plan"
  },
  "routing": {
    "low": {
      "builder": "sonnet",
      "code": "haiku"
    },
    "medium": {
      "builder": "sonnet",
      "code": "sonnet"
    },
    "high": {
      "builder": "opus",
      "code": "sonnet"
    }
  },
  "surface_reviewers": {
    "ui": {
      "ux": "sonnet",
      "ui": "haiku"
    },
    "security": {
      "security": "opus"
    }
  },
  "protected_paths": [
    ".github/*",
    ".sentrux/baseline.json",
    "Cargo.lock",
    "factory/checks.sh",
    "factory/config.json",
    "factory/tools.json",
    "orchestration/sentrux-gate-policy.v1.json",
    "rust-toolchain.toml"
  ],
  "human_review_paths": [
    ".github/*",
    "factory/*",
    ".claude/*",
    "orchestration/sentrux-gate-policy.v1.json",
    ".sentrux/*",
    "rust-toolchain.toml",
    "crates/code-intel-cli/Cargo.toml",
    "skills/*"
  ],
  "path_checks": [
    {
      "paths": [
        "skills/*",
        "tests/test_skill_package.py"
      ],
      "run": "python3 tests/test_skill_package.py -v"
    }
  ],
  "fail_patterns": [
    "\\btest result: FAILED\\b",
    "\\bpanicked at\\b"
  ],
  "gate_slots": 1,
  "signoff": false,
  "ports": {
    "base": 5100,
    "step": 10
  },
  "test_globs": [
    "crates/*/tests/*",
    "tests/*"
  ],
  "new_tests_must_fail_on_base": false,
  "holdout_required": false,
  "satisfaction": {
    "max_runs": 30,
    "timeout_s": 600
  },
  "holdout": {
    "max_respecs": 2
  },
  "ft": {
    "test": "cargo test -p code-intel --locked --no-fail-fast",
    "e2e": "",
    "shot": "",
    "setup": "cargo fetch --locked",
    "mutate_test": ""
  },
  "dev_server": {
    "cmd": "",
    "ready_url": "",
    "timeout": 60
  },
  "quality": {
    "tools": {
      "crapper": {
        "repo": "https://github.com/unclebob/crapper",
        "commit": "6fd92c4c9bcc56efb64a2f8743d5a2993bcfd42d"
      },
      "dryer": {
        "repo": "https://github.com/unclebob/dryer",
        "commit": "66ff6d21a42c04afcad89c78a80066176d1294b0"
      },
      "mutator": {
        "repo": "https://github.com/unclebob/mutator",
        "commit": "a5a0cb803b66e0cdb8bf471b3b08af701d424a41"
      }
    },
    "crap_max": null,
    "crap_coverage": false,
    "dry_threshold": null,
    "dry_paths": [],
    "mutation": false,
    "mutation_timeout_s": 900
  },
  "model_ladder": [
    "haiku",
    "sonnet",
    "opus"
  ],
  "tune": {
    "min_jobs": 5,
    "escape_rate_max": 0.1,
    "avg_rounds_max": 2.0,
    "reason_share_max": {
      "design-unsettled": 0.3,
      "flaky": 0.1,
      "base-red": 0.1
    },
    "required_refusals_per_job_max": 1.0
  },
  "lessons_repo": "",
  "intake_routing": {
    "specified": "sonnet",
    "open": "fable"
  },
  "plan": {
    "planners": [
      "opus",
      "sonnet",
      "fable"
    ],
    "judges": [
      "sonnet",
      "fable",
      "opus"
    ],
    "families": {
      "opus": "anthropic",
      "sonnet": "anthropic",
      "haiku": "anthropic",
      "fable": "anthropic"
    },
    "agree_min": 2
  },
  "reasons": [
    "design-unsettled",
    "scope",
    "test-missing",
    "test-weak",
    "correctness",
    "regression",
    "style",
    "env",
    "base-red",
    "flaky",
    "protected-path",
    "signoff",
    "conflict",
    "human-review-path",
    "unproven",
    "spec-conflict",
    "complexity",
    "duplication",
    "other"
  ],
  "prices_usd_per_mtok": {
    "claude-fable-5-1": {
      "input": 10.0,
      "output": 50.0,
      "cache_write_5m": 12.5,
      "cache_write_1h": 20.0,
      "cache_read": 0.25
    },
    "claude-opus-5-5": {
      "input": 4.0,
      "output": 20.0,
      "cache_write_5m": 5.0,
      "cache_write_1h": 8.0,
      "cache_read": 0.2
    },
    "claude-sonnet-5-5": {
      "input": 2.0,
      "output": 10.0,
      "cache_write_5m": 2.5,
      "cache_write_1h": 4.0,
      "cache_read": 0.2
    },
    "claude-haiku-5-5": {
      "input": 0.1,
      "output": 0.5,
      "cache_write_5m": 0.125,
      "cache_write_1h": 0.2,
      "cache_read": 0.01
    }
  },
  "light_checks": [
    {
      "paths": [
        "docs/*",
        "*.md"
      ],
      "except": [
        "factory/*",
        ".claude/*",
        "skills/*",
        "tests/*"
      ],
      "run": "python3 tests/test_repository_layout.py -v"
    }
  ],
  "decision_docs": [
    "docs/adr/*",
    "docs/decisions/*"
  ]
}
