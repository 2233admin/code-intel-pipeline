{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "code-intel-sentrux-capability-artifact.v1",
  "title": "Code Intel Sentrux capability artifact envelope v1",
  "description": "Snapshot-bound, non-silent result envelope shared by every Sentrux capability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contractVersion",
    "capabilityId",
    "operation",
    "runId",
    "snapshotIdentity",
    "provider",
    "status",
    "authority",
    "inputs",
    "outputs",
    "failure",
    "freshness",
    "decisionConsumers"
  ],
  "properties": {
    "schema": { "const": "code-intel-sentrux-capability-artifact.v1" },
    "contractVersion": { "const": 1 },
    "capabilityId": { "$ref": "#/$defs/identifier" },
    "operation": { "$ref": "#/$defs/identifier" },
    "runId": { "$ref": "#/$defs/nonEmpty" },
    "snapshotIdentity": { "$ref": "#/$defs/sha256" },
    "provider": { "$ref": "#/$defs/provider" },
    "status": {
      "enum": [
        "succeeded",
        "degraded",
        "unavailable",
        "skipped",
        "not_applicable",
        "failed"
      ]
    },
    "authority": {
      "enum": ["authoritative", "fallback", "compatibility", "declared_only"]
    },
    "inputs": { "type": "object" },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": { "type": ["object", "null"] },
        "verdict": { "enum": ["pass", "fail", "unknown"] },
        "outputSummary": {
          "oneOf": [
            { "$ref": "#/$defs/outputSummary" },
            { "type": "null" }
          ]
        },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactRef" },
          "uniqueItems": true
        }
      }
    },
    "failure": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/failure" }
      ]
    },
    "freshness": { "$ref": "#/$defs/freshness" },
    "decisionConsumers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "succeeded" } } },
      "then": { "properties": { "failure": { "type": "null" } } },
      "else": { "properties": { "failure": { "$ref": "#/$defs/failure" } } }
    },
    {
      "if": { "properties": { "status": { "const": "unavailable" } } },
      "then": {
        "properties": {
          "failure": {
            "type": "object",
            "properties": { "kind": { "const": "provider_unavailable" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "skipped" } } },
      "then": {
        "properties": {
          "failure": {
            "type": "object",
            "properties": { "kind": { "const": "skipped" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "not_applicable" } } },
      "then": {
        "properties": {
          "failure": {
            "type": "object",
            "properties": { "kind": { "const": "not_applicable" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "id", "version", "digest"],
      "properties": {
        "mode": {
          "enum": ["external", "builtin", "lite_fallback", "legacy_compatibility"]
        },
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/nonEmpty" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "artifactSchema",
        "type",
        "path",
        "sha256",
        "consumedSnapshotIdentity"
      ],
      "properties": {
        "schema": { "const": "code-intel-artifact-ref.v1" },
        "artifactSchema": { "$ref": "#/$defs/nonEmpty" },
        "type": { "const": "provider.sentrux.capability-artifact" },
        "path": { "$ref": "#/$defs/nonEmpty" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "consumedSnapshotIdentity": { "$ref": "#/$defs/sha256" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message", "retryable"],
      "properties": {
        "kind": {
          "enum": [
            "provider_unavailable",
            "provider_error",
            "config_error",
            "local_tool_error",
            "snapshot_mismatch",
            "stale_evidence",
            "degraded",
            "skipped",
            "not_applicable",
            "blocked_policy",
            "unknown"
          ]
        },
        "message": { "$ref": "#/$defs/nonEmpty" },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evaluatedAt", "consumedSnapshotIdentity"],
      "properties": {
        "status": {
          "enum": ["current", "stale", "snapshot_mismatch", "unknown"]
        },
        "evaluatedAt": { "type": "string", "format": "date-time" },
        "consumedSnapshotIdentity": { "$ref": "#/$defs/sha256" }
      }
    },
    "outputSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "complete", "bounded", "limitBytes", "totalBytes", "stdout", "stderr", "note"],
      "properties": {
        "authority": { "const": "metadata_only" },
        "complete": { "type": "boolean" },
        "bounded": { "type": "boolean" },
        "limitBytes": { "type": "integer", "minimum": 1 },
        "totalBytes": { "type": "integer", "minimum": 0 },
        "stdout": { "$ref": "#/$defs/outputStream" },
        "stderr": { "$ref": "#/$defs/outputStream" },
        "note": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "outputStream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256", "preview", "previewBytes"],
      "properties": {
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "preview": { "type": "string" },
        "previewBytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
