{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "code-intel-authority-event.v1.schema.json",
  "title": "Code Intel repository-governed authority event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "decision", "approver", "evidenceIds", "issuedAt", "expiresAt", "attestation"],
  "properties": {
    "schema": { "const": "code-intel-authority-event.v1" },
    "id": { "type": "string", "minLength": 1 },
    "decision": { "const": "approved" },
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "issuedAt": { "type": "integer", "minimum": 0 },
    "expiresAt": { "type": "integer", "minimum": 0 },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "digest"],
      "properties": {
        "scheme": { "const": "repository-governed-sha256-v1" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
