{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://code-intel.local/schemas/code-intel-sentrux-capability-matrix.v1.schema.json",
  "title": "Code Intel Sentrux Capability Matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contractVersion", "coverageStatus", "sources", "completionPolicy", "capabilities"],
  "properties": {
    "schema": { "const": "code-intel-sentrux-capability-matrix.v1" },
    "contractVersion": { "const": 1 },
    "coverageStatus": { "enum": ["partial", "complete"] },
    "purpose": { "type": "string", "minLength": 1 },
    "sources": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "completionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredStatesForComplete", "forbiddenSilentStates", "rule"],
      "properties": {
        "requiredStatesForComplete": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
        "forbiddenSilentStates": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
        "rule": { "type": "string", "minLength": 1 }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "operation", "aliases", "scope", "trigger", "route", "currentState", "requiredForRelease", "inputs", "artifacts", "decisionConsumers", "failureSemantics", "platforms"],
        "properties": {
          "id": { "type": "string", "pattern": "^sentrux\\.[a-z0-9_]+$" },
          "operation": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "aliases": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }, "uniqueItems": true },
          "scope": { "type": "string", "minLength": 1 },
          "trigger": { "type": "string", "minLength": 1 },
          "route": { "type": "string", "minLength": 1 },
          "currentState": { "enum": ["authoritative_automatic", "native_manual", "compatibility_only", "declared_only"] },
          "requiredForRelease": { "type": "boolean" },
          "inputs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
          "artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
          "decisionConsumers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "failureSemantics": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
          "platforms": { "type": "array", "items": { "enum": ["windows", "macos", "linux"] }, "minItems": 1, "uniqueItems": true }
        }
      }
    }
  }
}
